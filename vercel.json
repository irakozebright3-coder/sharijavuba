{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/station",
      "destination": "/station-app/index.html"
    },
    {
      "source": "/station/:path*",
      "destination": "/station-app/:path*"
    },
    {
      "source": "/rider",
      "destination": "/rider-app/index.html"
    },
    {
      "source": "/rider/:path*",
      "destination": "/rider-app/:path*"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30,
      "memory": 512
    }
  }
}
