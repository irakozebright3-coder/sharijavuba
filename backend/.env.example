DATABASE_URL=postgres://user:password@localhost:5432/sharijavuba
PORT=3000

# Kinyarwanda translations. Only needed to regenerate strings.rw.json,
# never read at runtime by the apps.
EJOCHAT_API_KEY=

# Where queue events are posted for the n8n workflow. Leave blank and the
# backend skips the webhook entirely; nothing else changes.
N8N_WEBHOOK_URL=

# Comma-separated production frontend origins; set on the backend host.
# Leave unset on Vercel: the apps and the API share an origin there, so no
# cross-origin request is ever made.
FRONTEND_ORIGINS=https://your-project.vercel.app

# Optional secret for POST /cron/sweep, for an outside scheduler that keeps
# the slip/no-show ladder running while nobody has the apps open. Unset means
# the route is closed (503) rather than open to anyone.
CRON_SECRET=

# Serverless connection sizing. Vercel defaults to 1 connection per function
# instance and exits the pool when idle; raise PG_POOL_MAX only on a
# long-lived host, and point DATABASE_URL at a pooled (Neon `-pooler`)
# connection when many functions run at once.
PG_POOL_MAX=

# TLS is turned on automatically for any non-local DATABASE_URL. Set
# PGSSL=disable for a host that terminates TLS somewhere else.
PGSSL=
