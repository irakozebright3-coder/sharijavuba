DATABASE_URL=postgres://user:password@localhost:5432/sharijavuba
PORT=3000

# Kinyarwanda translations. Only needed to regenerate strings.rw.json,
# never read at runtime by the apps.
EJOCHAT_API_KEY=

# Where queue events are posted for the n8n workflow. Leave blank and the
# backend skips the webhook entirely; nothing else changes.
N8N_WEBHOOK_URL=

# Comma-separated production frontend origins; set on the backend host.
FRONTEND_ORIGINS=https://your-project.vercel.app
